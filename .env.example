# Copie ce fichier en « .env » puis remplis les 2 valeurs depuis Supabase
# (voir README.md, étape 3). Ce fichier ne doit JAMAIS être partagé publiquement.

# URL du projet : Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://TON-PROJET.supabase.co

# Clé publique (anon) : Supabase → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=TA-CLE-PUBLIQUE-ANON
