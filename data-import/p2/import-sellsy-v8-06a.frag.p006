ntaire #14530530","lectureSeule":true},{"date":"2022-01-17","texte":"17/01/22 MV","provenance":"Sellsy commentaire #14778894","lectureSeule":true},{"date":"2026-11-23","texte":"09/12/21       Impossible d'avoir le gÃ©rant. EmployÃ© prend mes coordonnÃ©esnnLE 13/11 PI PAR L ELECTRIQUE","provenance":"Sellsy (Xefi)","lectureSeule":true}]},"contacts":[{"prenom":"Ludovic","nom":"VITRE (SAINT-LAURENT-DU-VAR)","role":"Dirigeant","email":"ludo1672@gmail.com","tel":"0698062732"},{"prenom":"Ludovic","nom":"VITRE (SAINT-LAURENT-DU-VAR)","role":"Dirigeant","email":"ludo1672@gmail.com","tel":"0698062732"},{"prenom":"Ludovic","nom":"VITRE (SAINT-LAURENT-DU-VAR)","role":"Dirigeant","email":"ludo1672@gmail.com","tel":"0698062732"},{"prenom":"","nom":"RONDEL","role":"","email":"","tel":""},{"prenom":"","nom":"CHHONG","role":"","email":"","tel":""},{"prenom":"Meysin","nom":"CHHONG","role":"","email":"","tel":""},{"prenom":"","nom":"BELLAZINI","role":"","email":"","tel":""}]}
