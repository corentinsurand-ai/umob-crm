e},{"date":"2026-11-23","texte":"03/04/19 NE VEUT LIVRER QU'EN VOITURE'","provenance":"Sellsy (Xefi)","lectureSeule":true},{"date":"2026-11-23","texte":"LE 26/01 RELANCE SUITE DEVIS PARLE DU BONUS MR DOIT VOIR AVEC ASSOCIE MAIS CE N EST PAS LA PRIORITE A CONTACTER FIN FEVRIER","provenance":"Sellsy (Xefi)","lectureSeule":true},{"date":"2022-10-20","texte":"⚠️ Impayé","provenance":"Sellsy commentaire #18380939","lectureSeule":true},{"date":"2023-07-24","texte":"Fermé définitivement, j'ai transmis l'adresse du scooter à Guillaume","provenance":"Sellsy commentaire #21738414","lectureSeule":true},{"date":"2023-10-09","texte":"Ferme définitivement, reprise mais ne fait pas de livraison.","provenance":"Sellsy commentaire #22577963","lectureSeule":true},{"date":"2026-11-23","texte":"CSU : 20/07/18 APPARAMENT SUR LA PHOTO GOOGLE IL LIVRE EN ECCITY","provenance":"Sellsy (Xefi)","lectureSeule":true}]},"contacts":[{"prenom":"Walid Aiman","nom":"Bourara","role":"Gérant","email":"ppb.peppone@gmail.com","tel":"0772381674"},{"prenom":"","nom":"HATHIME","role":"","email":"","tel":""},{"prenom":"","nom":"8991","role":"","email":"","tel":""},{"prenom":"","nom":"10037","role":"","email":"","tel":""},{"prenom":"","nom":"SALQUES","role":"","email":"","tel":""},{"prenom":"Xavier","nom":"BEDEL","role":"","email":"","tel":""},{"prenom":"","nom":"VILLEJOBERT","role":"","email":"","tel":""}]}
